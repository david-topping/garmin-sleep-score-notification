# Copy to .env (gitignored).

# Required: Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxx

# From address. Must be on a domain verified in Resend, or use the shared
# onboarding@resend.dev (which only delivers to your own Resend account email).
EMAIL_FROM=Garmin Sleep <garmin-sleep@davidtopp.ing>

# Optional (defaults shown)
# PEOPLE_FILE=./people.yaml
# STATE_FILE=./state/sent_state.json
# TIMEZONE=Europe/London   # else the VM's system timezone
# LOG_LEVEL=INFO
