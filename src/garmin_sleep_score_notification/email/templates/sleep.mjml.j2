{% macro bar(percent, colour, height=6, track="#eef0f4") %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:separate;">
  <tr>
    {% if percent > 0 %}
    <td width="{{ percent }}%" style="background:{{ colour }};height:{{ height }}px;line-height:{{ height }}px;font-size:0;border-radius:{{ height }}px;">&nbsp;</td>
    {% endif %}
    {% if percent < 100 %}
    <td style="background:{{ track }};height:{{ height }}px;line-height:{{ height }}px;font-size:0;border-radius:{{ height }}px;">&nbsp;</td>
    {% endif %}
  </tr>
</table>
{% endmacro %}
<mjml lang="en">
  <mj-head>
    <mj-title>{{ person }}'s sleep score</mj-title>
    <mj-preview>{{ score }}/100 {{ qualifier }} &middot; {{ total }} asleep</mj-preview>
    <mj-raw>
      <meta name="color-scheme" content="light only">
      <meta name="supported-color-schemes" content="light only">
    </mj-raw>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text padding="0" color="#2b303b" line-height="1.4" />
      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>
    <mj-style>
      :root { color-scheme: light only; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#ffffff" width="480px">
    <mj-wrapper padding="20px 16px 24px">
      <mj-section>
        <mj-column>
          <mj-text font-size="15px" font-weight="600" color="#4a5160">{{ day.strftime("%A") }} {{ day.day }} {{ day.strftime("%B") }}</mj-text>

          <mj-text padding="12px 0 0" line-height="1">
            <table role="presentation" cellpadding="0" cellspacing="0">
              <tr>
                <td style="vertical-align:middle;white-space:nowrap;"><span style="font-size:56px;font-weight:800;color:{{ colour }};letter-spacing:-0.02em;">{{ score }}</span><span style="font-size:20px;font-weight:600;color:#9aa0ac;"> / 100</span></td>
                <td style="vertical-align:middle;padding-left:14px;">
                  <span style="display:inline-block;padding:5px 11px;border-radius:999px;background:{{ colour }};color:#ffffff;font-size:13px;font-weight:700;">{{ qualifier }}</span>
                  {% if delta %}
                  <div style="padding-top:7px;font-size:13px;font-weight:600;color:{{ delta[1] }};white-space:nowrap;">{{ delta[0] }}</div>
                  {% endif %}
                </td>
              </tr>
            </table>
          </mj-text>
          <mj-text padding="14px 0 0">{{ bar(score, colour, height=8) }}</mj-text>

          {% if timeline_cid %}
          <mj-divider border-width="1px" border-color="#eef0f4" padding="22px 0 6px" />
          <mj-text font-size="12px" font-weight="700" letter-spacing="0.09em" text-transform="uppercase" color="#7b8394" padding="0 0 8px">Overnight</mj-text>
          <mj-image src="cid:{{ timeline_cid }}" alt="Sleep stage timeline: {{ timeline_alt }}" width="448px" padding="0" />
          {% endif %}

          <mj-divider border-width="1px" border-color="#eef0f4" padding="18px 0 4px" />
          <mj-table padding="0" font-size="14px" color="#4a5160" cellpadding="0" cellspacing="0">
            {% for st in stages %}
            <tr>
              <td style="padding:12px 0 6px;width:18px;"><span style="display:inline-block;width:10px;height:10px;border-radius:3px;background:{{ st.colour }};"></span></td>
              <td style="padding:12px 0 6px;">{{ st.label }}</td>
              <td style="padding:12px 0 6px;text-align:right;color:#2b303b;font-weight:600;">{{ st.duration }}</td>
              <td style="padding:12px 0 6px 12px;text-align:right;color:#9aa0ac;width:44px;">{{ "%d%%"|format(st.percent) if st.percent is not none else "&mdash;"|safe }}</td>
            </tr>
            {% if st.percent is not none %}
            <tr><td></td><td colspan="3" style="padding:0;">{{ bar(st.percent, st.colour, height=4) }}</td></tr>
            {% endif %}
            {% endfor %}
            <tr>
              <td colspan="2" style="padding:16px 0 0;border-top:1px solid #e6e9ee;color:#2b303b;font-weight:700;">Total sleep</td>
              <td colspan="2" style="padding:16px 0 0;border-top:1px solid #e6e9ee;text-align:right;color:#2b303b;font-weight:800;font-size:16px;">{{ total }}</td>
            </tr>
          </mj-table>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
